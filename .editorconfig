# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = crlf

[*.{cs,fs}]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{html,cshtml}]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[.dockerignore]
end_of_line = lf

# shell scripts and workflows run on Linux, keep them LF
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true

[*.{yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
