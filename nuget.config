<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="repositoryPath" value="packages" />
  </config>
  <activePackageSource>
    <add key="All" value="(Aggregate source)" />
  </activePackageSource>
  <packageSources>
    <!-- Credentials for LakerfieldFeed belong in your user-level NuGet.Config, never in this file. See README. -->
    <add key="LakerfieldFeed" value="https://lakerfield.pkgs.visualstudio.com/_packaging/LakerfieldFeed/nuget/v3/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
