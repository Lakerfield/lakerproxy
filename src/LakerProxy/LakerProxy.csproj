<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LakerProxy</RootNamespace>
    <Product>LakerProxy</Product>
    <Company>Lakerfield B.V.</Company>
    <Authors>Michael Lakerveld</Authors>
    <Copyright>Lakerfield B.V.</Copyright>
    <RepositoryUrl>https://github.com/lakerfield/lakerproxy</RepositoryUrl>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Lakerfield.Core" />
    <PackageReference Include="Lakerfield.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app-configuration-override.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="app-configuration.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
