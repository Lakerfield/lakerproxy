<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Product>LakerProxy</Product>
    <Company>Lakerfield B.V.</Company>
    <Authors>Michael Lakerveld</Authors>
    <Copyright>Lakerfield B.V.</Copyright>
    <RepositoryUrl>https://github.com/lakerfield/lakerproxy</RepositoryUrl>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="IPNetwork2" Version="4.0.2">
      <Aliases>IPNetwork2</Aliases>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\LakerProxy.Runtime\LakerProxy.Runtime.csproj" />
    <ProjectReference Include="..\LakerProxy.WebApi\LakerProxy.WebApi.csproj" />
  </ItemGroup>

</Project>
