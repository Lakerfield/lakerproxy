<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Authors>Michael Lakerveld</Authors>
    <Company>Lakerfield B.V.</Company>
    <Product>Proxy Manager</Product>
    <Copyright>Lakerfield B.V.</Copyright>
    <RepositoryUrl>https://github.com/lakerfield/lakerproxy</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>lakerproxy.ico</ApplicationIcon>
    <AssemblyName>LakerProxyManager</AssemblyName>
    <!-- Velopack must run before WPF starts, so App.xaml.cs has its own Main (see App.xaml.cs) -->
    <StartupObject>LakerProxy.ProxyPlayground.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Caliburn.Micro" />
    <PackageReference Include="DnsClient" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Reactive" />
    <!-- keep in sync with the vpk CLI version in .github/workflows/release-manager.yaml -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LakerProxy.WebApi\LakerProxy.WebApi.csproj" />
  </ItemGroup>

	<ItemGroup>
    <Page Update="Views\ApiUsersView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\WebsitesView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Views\ApiUserView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\WebsiteView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
  </ItemGroup>

</Project>
