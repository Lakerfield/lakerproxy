<UserControl x:Class="LakerProxy.ProxyPlayground.Views.AcmeAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="200" MinWidth="300">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">

      <Button x:Name="Refresh" Style="{StaticResource IconButton}" Content="{StaticResource Icon.ArrowSync}" ToolTip="Refresh" />
      <Button x:Name="New" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Add}" ToolTip="New" Margin="8,0,0,0" />
      <Button x:Name="Edit" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Edit}" ToolTip="Edit" />
      <Button x:Name="Copy" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Copy}" ToolTip="Copy" />

    </StackPanel>

    <DataGrid x:Name="ConnectionDataGrid"
              ItemsSource="{Binding Entities}"
              SelectedItem="{Binding SelectedEntity}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True"
              FontFamily="Consolas"
              Grid.Row="1"
              MouseDoubleClick="ConnectionDataGridMouseDoubleClick">

      <DataGrid.Columns>
        <DataGridTextColumn IsReadOnly="True" Header="Code" Binding="{Binding Entity.Code}"/>
        <DataGridTextColumn IsReadOnly="True" Header="Name" Binding="{Binding Entity.Name}"/>
        <DataGridComboBoxColumn IsReadOnly="True" Header="Type" SelectedValueBinding="{Binding Entity.Type, Converter={StaticResource EnumListAcmeAccountTypes}}" ItemsSource="{StaticResource EnumListAcmeAccountTypes}" />
        <DataGridCheckBoxColumn IsReadOnly="True" Header="Default" Binding="{Binding Entity.Default}"/>
        <DataGridTextColumn IsReadOnly="True" Header="Mail" Binding="{Binding Entity.Mail}"/>
        <DataGridCheckBoxColumn IsReadOnly="True" Header="Eab" Binding="{Binding Entity.UseEab}"/>
        <DataGridTextColumn IsReadOnly="True" Header="DiscoveryUrl" Binding="{Binding Entity.AcmeDiscoveryUrl}"/>
        <DataGridTextColumn IsReadOnly="True" Header="AccountUrl" Binding="{Binding Entity.AccountUrl}"/>
        <DataGridTextColumn IsReadOnly="True" Header="Id" Binding="{Binding Entity.Id}" />
      </DataGrid.Columns>

    </DataGrid>

  </Grid>
</UserControl>
