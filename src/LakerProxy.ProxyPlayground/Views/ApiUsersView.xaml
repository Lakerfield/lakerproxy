<UserControl x:Class="LakerProxy.ProxyPlayground.Views.ApiUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="200" MinWidth="300">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">

      <Button x:Name="Refresh" Style="{StaticResource IconButton}" Content="{StaticResource Icon.ArrowSync}" ToolTip="Refresh" />
      <Button x:Name="New" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Add}" ToolTip="New" Margin="8,0,0,0" />
      <Button x:Name="Edit" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Edit}" ToolTip="Edit" />
      <Button x:Name="Copy" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Copy}" ToolTip="Copy" />
      <Button x:Name="Delete" Style="{StaticResource DangerIconButton}" Content="{StaticResource Icon.Delete}" ToolTip="Delete" />

    </StackPanel>

    <DataGrid x:Name="ConnectionDataGrid" 
              ItemsSource="{Binding Entities}" 
              SelectedItem="{Binding SelectedEntity}" 
              AutoGenerateColumns="False" 
              CanUserAddRows="False"
              IsReadOnly="True"
              FontFamily="Consolas"
              Grid.Row="1" 
              MouseDoubleClick="ConnectionDataGridMouseDoubleClick">
      <DataGrid.Resources>
        <Style x:Key="CellRightAlign">
          <Setter Property="Control.HorizontalAlignment"
                  Value="Right" />
        </Style>
      </DataGrid.Resources>

      <DataGrid.Columns>
        <DataGridTextColumn IsReadOnly="True" Header="Name" Binding="{Binding Entity.Name}"/>
        <DataGridTextColumn IsReadOnly="True" Header="Hostname" Binding="{Binding Entity.Hostname, Converter={StaticResource DomainExtensionFillConverter}}" CellStyle="{StaticResource CellRightAlign}"/>
        <DataGridComboBoxColumn IsReadOnly="True" Header="Rights" SelectedValueBinding="{Binding Entity.Rights, Converter={StaticResource EnumListApiUserRights}}" ItemsSource="{StaticResource EnumListApiUserRights}" />
        <DataGridTextColumn IsReadOnly="True" Header="Server" Binding="{Binding Entity.Server}" />
        <DataGridTextColumn IsReadOnly="True" Header="Website" Binding="{Binding Entity.Website}" />
        <DataGridTextColumn IsReadOnly="True" Header="Acme" Binding="{Binding Entity.AcmeAccount}"/>
        <DataGridTextColumn IsReadOnly="True" Header="Comments" Binding="{Binding Entity.Comments}"/>

        <DataGridTextColumn IsReadOnly="True" Header="Id" Binding="{Binding Entity.Id}" />
      </DataGrid.Columns>

      <!--<DataGrid.RowDetailsTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"></ColumnDefinition>
              <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <controls:ObjectView DataContext="{Binding ObjectHierarchy}" HorizontalAlignment="Left" MinWidth="160" MaxHeight="320" Grid.Column="1"></controls:ObjectView>
          </Grid>
        </DataTemplate>
      </DataGrid.RowDetailsTemplate>-->


    </DataGrid>

  </Grid>
</UserControl>
