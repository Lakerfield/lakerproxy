<Window x:Class="LakerProxy.ProxyPlayground.Views.Settings.ProxyServersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        Title="Proxy servers" SizeToContent="WidthAndHeight" MinHeight="320" MinWidth="480">
  <Grid Margin="8,0,8,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">

      <Button x:Name="New" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Add}" ToolTip="New" />
      <Button x:Name="Edit" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Edit}" ToolTip="Edit" />
      <Button x:Name="Copy" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Copy}" ToolTip="Copy" />
      <Button x:Name="Delete" Style="{StaticResource DangerIconButton}" Content="{StaticResource Icon.Delete}" ToolTip="Delete" />

      <Button x:Name="Select" Style="{StaticResource IconButton}" Content="{StaticResource Icon.CheckmarkCircle}" ToolTip="Select" Margin="8,0" />

    </StackPanel>

    <DataGrid x:Name="ConnectionDataGrid" 
              ItemsSource="{Binding ProxyServers}" 
              SelectedItem="{Binding SelectedProxyServer}" 
              AutoGenerateColumns="False" 
              CanUserAddRows="False"
              IsReadOnly="True"
              Grid.Row="1" 
              MouseDoubleClick="ConnectionDataGridMouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Groep" Binding="{Binding Groep}"></DataGridTextColumn>
        <DataGridTextColumn Header="Omschrijving" Binding="{Binding Omschrijving}"></DataGridTextColumn>
        <DataGridTextColumn Header="Username" Binding="{Binding Username}"></DataGridTextColumn>
        <DataGridTextColumn Header="Url" Binding="{Binding Url}"></DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</Window>
