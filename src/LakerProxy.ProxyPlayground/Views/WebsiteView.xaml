<Window x:Class="LakerProxy.ProxyPlayground.Views.WebsiteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LakerProxy.ProxyPlayground.Controls"
        Title="Website settings" MinHeight="480" MinWidth="360" 
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight">
  <Grid Margin="8,0,8,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <StackPanel>
        <TextBlock controls:TextBlockProperties.FormattedText="{Binding Entity.Hostname}" 
                   FontFamily="Consolas" FontSize="20" 
                   Margin="4,4,0,8" />

        <TextBlock Text="Kind"></TextBlock>
        <ComboBox SelectedValue="{Binding Entity.Kind, Converter={StaticResource EnumListWebsiteKind}}" ItemsSource="{StaticResource EnumListWebsiteKind}"/>

        <TextBlock Text="Hostname" Margin="0,8,0,0" />
        <TextBox Text="{Binding Entity.Hostname}"></TextBox>

        <CheckBox IsChecked="{Binding Entity.Fallback}" Margin="0,8,0,0">Fallback</CheckBox>

        <TextBlock Margin="0,8,0,0">Certificate</TextBlock>
        <ComboBox SelectedValue="{Binding Entity.Scope, Converter={StaticResource EnumListCertificateScope}}" ItemsSource="{StaticResource EnumListCertificateScope}"/>

        <CheckBox IsChecked="{Binding Entity.ForceRenew}">Force renew certificate</CheckBox>

        <TextBlock Text="Dns-01 validation CNAME record" Margin="0,8,0,0" />
        <Border BorderBrush="LightGray" BorderThickness="1" Padding="6" Background="#FFF8F8F8">
          <StackPanel>
            <TextBlock Text="Add this CNAME record to the DNS zone of the hostname to delegate acme dns-01 validation to the proxy:"
                       TextWrapping="Wrap" Foreground="DimGray" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,2" />
              <TextBox Text="{Binding DnsCnameName, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Grid.Column="1" Margin="0,0,0,2" />
              <Button Name="CopyDnsName" Content="Copy" Padding="4,2" Grid.Column="2" Margin="4,0,0,2" />

              <TextBlock Text="Value" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Row="1" />
              <TextBox Text="{Binding DnsCnameValue, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Grid.Row="1" Grid.Column="1" />
              <Button Name="CopyDnsValue" Content="Copy" Padding="4,2" Grid.Row="1" Grid.Column="2" Margin="4,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Destination" Margin="0,8,0,0" />
        <TextBox Text="{Binding Entity.Destination}"></TextBox>

        <TextBlock Text="Protocol" Margin="0,8,0,0"></TextBlock>
        <ComboBox SelectedValue="{Binding Entity.DestinationProtocol, Converter={StaticResource EnumListDestinationProtocol}}" ItemsSource="{StaticResource EnumListDestinationProtocol}"/>

        <TextBlock Text="Servers" Margin="0,8,0,0" />
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Entity.Servers, Mode=TwoWay, Converter={StaticResource StringsToMultiLineConverter}}"></TextBox>

        <TextBlock Text="Filter" Margin="0,8,0,0" />
        <ComboBox SelectedValue="{Binding Entity.Filter, Converter={StaticResource EnumListFilterKind}}" ItemsSource="{StaticResource EnumListFilterKind}"/>
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Entity.FilterAcl, Mode=TwoWay, Converter={StaticResource StringsToMultiLineConverter}}"></TextBox>
        <TextBlock Text="Filter redirect destination" Margin="0,8,0,0" />
        <TextBox Text="{Binding Entity.FilterDestination}"></TextBox>

        <TextBlock Text="AcmeAccount" Margin="0,8,0,0" />
        <TextBox Text="{Binding Entity.AcmeAccount}"></TextBox>

        <TextBlock Text="Max request body size" Margin="0,8,0,0" />
        <TextBox Text="{Binding Entity.MaxRequestBodySize}" ToolTip="Leave empty or type 'default' for the default 30MB limit. Use values like '120KB', '5MB', or '128MB' (max)."></TextBox>

        <TextBlock Text="Max website data size" Margin="0,8,0,0" />
        <TextBox Text="{Binding Entity.MaxWebsiteDataSize}" ToolTip="Maximum uncompressed size of the uploaded website zip. Leave empty or type 'default' for the default 20MB limit. Use values like '5MB' or '50MB', or 'max' (256MB)."></TextBox>

        <TextBlock Text="Tags (words separated by space)" Margin="0,8,0,0" />
        <TextBox Text="{Binding TagsText}" ToolTip="Free-form words to group and filter websites in the manager, e.g. 'customer-x production'"></TextBox>

        <TextBlock Text="Comments" Margin="0,8,0,0" />
        <TextBox Text="{Binding Entity.Comments}" AcceptsReturn="True"></TextBox>

      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="1" Height="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Name="Ok" Content="Ok" />
      <Button Name="Cancel" Content="Cancel" Grid.Column="1" />
    </Grid>

  </Grid>
</Window>
