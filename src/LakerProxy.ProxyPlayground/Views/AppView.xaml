<Window x:Class="LakerProxy.ProxyPlayground.Views.AppView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:views="clr-namespace:LakerProxy.ProxyPlayground.Views"
        Title="LakerProxy Manager" Height="640" Width="1200" WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">

      <Button x:Name="Connect" Style="{StaticResource IconButton}" Content="{StaticResource Icon.PlugConnected}" ToolTip="Connect to proxy server" />

      <TextBlock Text="{Binding ConnectedServerName}" VerticalAlignment="Center" FontWeight="Bold" Margin="4,0,8,0" />

      <Button x:Name="OpenWebsites" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Globe}" ToolTip="Open websites from connected proxy server" Margin="16,0,0,0" />
      <Button x:Name="OpenUsers" Style="{StaticResource IconButton}" Content="{StaticResource Icon.People}" ToolTip="Open users from connected proxy server" />
      <Button x:Name="OpenServers" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Server}" ToolTip="Open servers from connected proxy server" />
      <Button x:Name="OpenAcmeAccounts" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Key}" ToolTip="Open acme accounts from connected proxy server" />
      <Button x:Name="OpenLogs" Style="{StaticResource IconButton}" Content="{StaticResource Icon.TextBulletListSquare}" ToolTip="Open live logs from connected proxy server" />
      <Button x:Name="OpenAcmeLogs" Style="{StaticResource IconButton}" Content="{StaticResource Icon.DocumentBulletList}" ToolTip="Open live acme logs from connected proxy server" />

      <Button x:Name="OpenSettingsFile" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Settings}" ToolTip="Open app settings file in notepad" Margin="8,0,0,0" />

    </StackPanel>

    <views:AppVersion Grid.Row="0" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"></views:AppVersion>

    <TabControl x:Name="Items" SelectedItem="{Binding SelectedTab}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DisplayName}" />
            <!--<TextBlock Text="{Binding PartijenCount, StringFormat='{} ({0})'}"></TextBlock>-->
            <Button Style="{StaticResource TabCloseButton}" Margin="8,0,0,0" Content="X" cal:Message.Attach="CloseItem($dataContext)" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
    <!--<ContentControl x:Name="ActiveItem" Grid.Row="1" />-->

  </Grid>
</Window>
