<Window x:Class="LakerProxy.ProxyPlayground.Views.AppView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:views="clr-namespace:LakerProxy.ProxyPlayground.Views"
        Title="LakerProxy Manager" Height="640" Width="1200" WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">

      <Button x:Name="Connect" ToolTip="Connect to proxy server">
        <Image Source="/Images/plug_add32.png" Height="32" />
      </Button>

      <TextBlock Text="{Binding ConnectedServerName}" VerticalAlignment="Center" FontWeight="Bold" Margin="4,0,8,0" />

      <Button x:Name="OpenWebsites" ToolTip="Open websites from connected proxy server" Margin="16,0,0,0">
        <Image Source="/Images/server_edit.png" Height="32" />
      </Button>

      <Button x:Name="OpenUsers" ToolTip="Open users from connected proxy server">
        <Image Source="/Images/users3_edit.png" Height="32" />
      </Button>

      <Button x:Name="OpenServers" ToolTip="Open servers from connected proxy server">
        <Image Source="/Images/server_into.png" Height="32" />
      </Button>

      <Button x:Name="OpenAcmeAccounts" ToolTip="Open acme accounts from connected proxy server">
        <Image Source="/Images/preferences32.png" Height="32" />
      </Button>

      <Button x:Name="OpenLogs" ToolTip="Open live logs from connected proxy server">
        <Image Source="/Images/document.png" Height="32" />
      </Button>

      <Button x:Name="OpenAcmeLogs" ToolTip="Open live acme logs from connected proxy server">
        <Image Source="/Images/cloud_computing_download.png" Height="32" />
      </Button>

      <Button x:Name="OpenSettingsFile" ToolTip="Open app settings file in notepad" Margin="8,0,0,0">
        <Image Source="/Images/document_down.png" Height="32" />
      </Button>

    </StackPanel>

    <views:AppVersion Grid.Row="0" Grid.Column="1" Margin="8"></views:AppVersion>

    <TabControl x:Name="Items" SelectedItem="{Binding SelectedTab}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DisplayName}" />
            <!--<TextBlock Text="{Binding PartijenCount, StringFormat='{} ({0})'}"></TextBlock>-->
            <Button Style="{StaticResource TabCloseButton}" Margin="8,0,0,0" Content="X" cal:Message.Attach="CloseItem($dataContext)" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
    <!--<ContentControl x:Name="ActiveItem" Grid.Row="1" />-->

  </Grid>
</Window>
