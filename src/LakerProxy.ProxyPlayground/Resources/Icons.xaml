  <!-- Toolbar icons: Fluent UI System Icons, 24px regular (MIT, https://github.com/microsoft/fluentui-system-icons).
       Path data is copied 1:1 from assets/<Name>/SVG/ic_fluent_<name>_24_regular.svg. -->

  <!-- A Geometry used as Content of a button renders as a 24x24 path in the inherited Foreground -->
  <DataTemplate DataType="{x:Type Geometry}">
    <Path Data="{Binding}" Width="24" Height="24" Stretch="None"
          Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
  </DataTemplate>

  <Style x:Key="IconButton" TargetType="ButtonBase">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Foreground" Value="#FF333333" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.35" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- destructive actions -->
  <Style x:Key="DangerIconButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
    <Setter Property="Foreground" Value="Firebrick" />
  </Style>

