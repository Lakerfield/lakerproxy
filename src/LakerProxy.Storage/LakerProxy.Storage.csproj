<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LakerProxy</RootNamespace>
    <Product>LakerProxy</Product>
    <Company>Lakerfield B.V.</Company>
    <Authors>Michael Lakerveld</Authors>
    <Copyright>Lakerfield B.V.</Copyright>
    <RepositoryUrl>https://github.com/lakerfield/lakerproxy</RepositoryUrl>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lakerfield.Acme" Version="1.0.2" />
    <PackageReference Include="Lakerfield.Storage" />
    <!-- MongoDB.Driver 2.x (via Lakerfield.Storage) pulls vulnerable Snappier 1.0.0 / SharpCompress 0.30.1.
         Pinned to the versions MongoDB.Driver 3.x ships with; remove once Lakerfield.Storage moves to driver 3.x. -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LakerProxy\LakerProxy.csproj" />
  </ItemGroup>

</Project>
